# LIFEKIT optional content API — environment variables
#
# Copy this file to `.env` (or export the values in your shell / hosting dashboard).
# Never commit real values. The frontend never receives any of these.
#
# The core LIFEKIT offline app does not need this server at all. These settings are only
# for an operator who wants to publish public announcements and reviewed directory
# listings to users who have opted in to fetching remote content.

# REQUIRED. At least 32 random characters. Signs admin session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIFEKIT_SESSION_SECRET=

# REQUIRED for admin login. A scrypt hash, never the plaintext password.
# Generate: npm run server:hash -- "a long passphrase of at least 12 characters"
LIFEKIT_ADMIN_PASSWORD_HASH=

# Optional. Salt for hashing client IPs before they are used in rate-limit keys.
# Defaults to the session secret.
LIFEKIT_IP_SALT=

# Optional. Path to the JSON content file. Default: server/data/db.json
# Mount a persistent volume here on hosts that reset the filesystem.
LIFEKIT_DATA_FILE=

# Optional. Set to "false" ONLY for local development over plain HTTP.
# Default is true, which is what production HTTPS requires.
LIFEKIT_COOKIE_SECURE=true

# Optional. Port and bind address for the API. Default 8787 on 0.0.0.0
PORT=8787
HOST=0.0.0.0

# Optional, if you later add a managed PostgreSQL instance instead of the JSON file.
# The server does not require this; see server/README.md for the adapter notes.
# DATABASE_URL=postgres://user:password@host:5432/lifekit?sslmode=require

# Optional, if you later add web push. Push is NOT part of this release.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
