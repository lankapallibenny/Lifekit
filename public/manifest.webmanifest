{
  "name": "LIFEKIT — Everyday Tools. A Better Life.",
  "short_name": "LIFEKIT",
  "description": "A free, offline-first toolkit for money records, daily planning, learning, career preparation, digital safety and community resources. No AI, no bank linking, no ads, no tracking.",
  "id": "/lifekit/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0B1F3A",
  "theme_color": "#0B1F3A",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "finance", "education", "utilities"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Add expense", "short_name": "Expense", "url": "./index.html#/money?quick=expense" },
    { "name": "Today's plan", "short_name": "Planner", "url": "./index.html#/planner" },
    { "name": "Offline tools", "short_name": "Tools", "url": "./index.html#/tools" }
  ]
}
